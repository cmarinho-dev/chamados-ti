@model ChamadosTI.Models.AdministrativoDepartamentosViewModel
@{
    ViewData["Title"] = "Departamentos";
}

<section class="page">
    <div class="page-header">
        <div>
            <p class="eyebrow">Administrativo</p>
            <h1>Departamentos</h1>
        </div>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert success">@success</div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert danger-alert">@error</div>
    }

    <section class="card componente-card">
        <h2 class="section-title">Gerenciar departamentos</h2>

        <form asp-action="AdicionarDepartamento" method="post" class="componente-inline-form">
            @Html.AntiForgeryToken()
            <input class="input" name="nome" placeholder="Nome do departamento" maxlength="120" />
            <button type="submit" class="btn primary">Adicionar</button>
        </form>

        <form asp-action="Departamentos" method="get" class="componente-inline-form">
            <input class="input" name="pesquisa" value="@Model.Pesquisa" placeholder="Buscar departamento" maxlength="120" />
            <button type="submit" class="btn ghost">Buscar</button>
        </form>

        <div class="componente-lista">
            @if (Model.Departamentos.Count == 0)
            {
                <div class="muted">Nenhum departamento cadastrado.</div>
            }
            else
            {
                foreach (var item in Model.Departamentos)
                {
                    <div class="componente-item">
                        <span>@item.Nome</span>
                        <form asp-action="ExcluirDepartamento" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Excluir departamento?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn danger icon-btn">Excluir</button>
                        </form>
                    </div>
                }
            }
        </div>

    </section>
</section>
