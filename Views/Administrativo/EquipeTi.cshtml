@model ChamadosTI.Models.EquipeTiViewModel
@{
    ViewData["Title"] = "Equipe de TI";
}

<section class="page">
    <div class="page-header">
        <div>
            <p class="eyebrow">Administrativo</p>
            <h1>Equipe de TI</h1>
            <p class="muted">Cadastre os membros do NIT e defina o período de atendimento. Os chamados serão distribuídos automaticamente em rodízio.</p>
        </div>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert success">@success</div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert danger-alert">@error</div>
    }

    <section class="card componente-card">
        <h2 class="section-title">Adicionar pessoa de TI</h2>

        <form asp-action="AdicionarTecnico" method="post" class="componente-inline-form equipe-ti-add-form">
            @Html.AntiForgeryToken()
            <input class="input" name="nome" maxlength="160" placeholder="Nome completo" required />
            <select class="input" name="periodo" required>
                <option value="">Selecione o período</option>
                <option value="Manhã">Manhã</option>
                <option value="Tarde">Tarde</option>
            </select>
            <button type="submit" class="btn primary">Adicionar</button>
        </form>

        <form asp-action="EquipeTi" method="get" class="componente-inline-form">
            <input class="input" name="pesquisa" value="@Model.Pesquisa" placeholder="Buscar por nome" maxlength="120" />
            <button type="submit" class="btn ghost">Buscar</button>
        </form>

        <div class="componente-lista">
            @if (Model.Tecnicos.Count == 0)
            {
                <div class="muted">Nenhuma pessoa cadastrada na equipe de TI.</div>
            }
            else
            {
                foreach (var tecnico in Model.Tecnicos)
                {
                    <article class="componente-item equipe-ti-item">
                        <div>
                            <strong>@tecnico.Nome</strong>
                            <div class="muted">Período atual: @tecnico.Periodo</div>
                        </div>
                        <div class="equipe-ti-item-actions">
                            <form asp-action="AtualizarPeriodoTecnico" asp-route-id="@tecnico.Id" method="post" class="equipe-ti-period-form">
                                @Html.AntiForgeryToken()
                                <select class="input" name="periodo" aria-label="Período de @tecnico.Nome">
                                    @if (tecnico.Periodo == "Manhã")
                                    {
                                        <option value="Manhã" selected>Manhã</option>
                                        <option value="Tarde">Tarde</option>
                                    }
                                    else
                                    {
                                        <option value="Manhã">Manhã</option>
                                        <option value="Tarde" selected>Tarde</option>
                                    }
                                </select>
                                <button type="submit" class="btn ghost icon-btn">Salvar período</button>
                            </form>
                            <form asp-action="ExcluirTecnico" asp-route-id="@tecnico.Id" method="post" onsubmit="return confirm('Remover esta pessoa da equipe de TI?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn danger icon-btn">Excluir</button>
                            </form>
                        </div>
                    </article>
                }
            }
        </div>
    </section>
</section>
