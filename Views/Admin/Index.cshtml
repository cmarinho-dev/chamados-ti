@model ChamadosTI.Models.PainelAdminViewModel
@{
    ViewData["Title"] = "Chamados";
}

<section class="page">
    <audio id="notifySound" src="~/audio/alert.mp3" preload="auto"></audio>
    <div class="page-header">
        <div>
            <p class="eyebrow">Painel</p>
            <h1>Atendimento de chamados</h1>
        </div>
        <div class="header-actions">
            <button type="button" class="btn ghost" data-audio-enable>Ativar som</button>
            <form asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn ghost">Sair</button>
            </form>
        </div>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert success">@success</div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert danger-alert">@error</div>
    }

    <div class="stats">
        <div class="stat-card">
            <div class="muted">Total de chamados</div>
            <div class="stat-value" data-total-open>@Model.TotalChamados</div>
        </div>
        <div class="stat-card">
            <div class="muted">Último solicitante</div>
            <div class="stat-value">@(!string.IsNullOrWhiteSpace(Model.UltimoSolicitante) ? Model.UltimoSolicitante : "-")</div>
            <span class="sr-only" data-latest-id-value>@Model.UltimoId</span>
        </div>
    </div>

    <form asp-action="Index" method="get" class="componente-inline-form" style="margin-bottom: 12px;">
        <input class="input" name="pesquisa" value="@Model.Pesquisa" placeholder="Buscar por nome, período, técnico, status ou descrição" />
        <button type="submit" class="btn primary">Buscar</button>
    </form>

    <div class="card dashboard" data-admin-listener="true" data-latest-id="@Model.UltimoId">
        <div class="ticket-list" data-ticket-list>
            @if (Model.Chamados.Count == 0)
            {
                <div class="muted">Nenhum chamado encontrado.</div>
            }
            else
            {
                foreach (var chamado in Model.Chamados)
                {
                    <article class="ticket" data-ticket-id="@chamado.Id" data-status="@chamado.Situacao">
                        <div class="ticket-header">
                            <strong>#@chamado.Id — @chamado.NomeSolicitante</strong>
                            <div class="pill status @($"status-{chamado.Situacao.Replace(" ", "-").ToLowerInvariant()}")">@chamado.Situacao</div>
                        </div>

                        <div class="ticket-meta">
                            <div class="ticket-meta-main">
                                <span>@chamado.Setor</span>
                                <div class="ticket-meta-sep">|</div>
                                <span>Período: @chamado.Periodo</span>
                                @if (chamado.InventarioItem != null)
                                {
                                    <div class="ticket-meta-sep">|</div>
                                    <span>Inventário: @chamado.InventarioItem.InventarioNumero</span>
                                }
                            </div>
                            <span>@chamado.CriadoEm.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>

                        <div class="ticket-detail">
                            <strong>Problema informado</strong>
                            <p>@(string.IsNullOrWhiteSpace(chamado.DescricaoProblema) ? "Não informado." : chamado.DescricaoProblema)</p>
                        </div>

                        @if (chamado.Situacao == "Finalizado")
                        {
                            <div class="ticket-resolution">
                                <strong>Responsável: @(chamado.TecnicoTi?.Nome ?? "Técnico removido")</strong>
                                <p>@(string.IsNullOrWhiteSpace(chamado.ParecerFinal) ? "Nenhum parecer informado." : chamado.ParecerFinal)</p>
                                @if (chamado.FinalizadoEm.HasValue)
                                {
                                    <span class="muted">Finalizado em @chamado.FinalizadoEm.Value.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</span>
                                }
                            </div>
                            <form asp-action="ReabrirChamado" asp-route-id="@chamado.Id" method="post" class="ticket-actions">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn ghost">Reabrir chamado</button>
                            </form>
                        }
                        else
                        {
                            @if (Model.TecnicosDisponiveis.Count == 0)
                            {
                                <div class="alert danger-alert">
                                    Cadastre alguém na <a asp-controller="Administrativo" asp-action="EquipeTi"><u>Equipe de TI</u></a> para iniciar o atendimento.
                                </div>
                            }
                            else
                            {
                                <div class="ticket-responsible">
                                    <div class="ticket-responsible-name">
                                        <span class="muted">Responsável de TI</span>
                                        <strong>@(chamado.TecnicoTi?.Nome ?? "Não definido")</strong>
                                    </div>
                                    <div class="ticket-actions">
                                        <button type="button" class="btn ghost" data-dialog-open="responsavel-dialog-@chamado.Id">
                                            @(chamado.TecnicoTiId.HasValue ? "Alterar responsável" : "Definir responsável")
                                        </button>
                                        @if (chamado.TecnicoTiId.HasValue)
                                        {
                                            <button type="button" class="btn primary" data-dialog-open="finalizar-dialog-@chamado.Id">Finalizar chamado</button>
                                        }
                                    </div>
                                </div>

                                <dialog id="responsavel-dialog-@chamado.Id" class="ticket-dialog" aria-labelledby="responsavel-titulo-@chamado.Id">
                                    <div class="ticket-dialog-content">
                                        <div class="ticket-dialog-header">
                                            <div>
                                                <span class="eyebrow">Chamado #@chamado.Id</span>
                                                <h2 id="responsavel-titulo-@chamado.Id">@(chamado.TecnicoTiId.HasValue ? "Alterar responsável" : "Definir responsável")</h2>
                                            </div>
                                            <button type="button" class="ticket-dialog-close" data-dialog-close aria-label="Fechar">×</button>
                                        </div>
                                        <form asp-action="AtribuirTecnico" asp-route-id="@chamado.Id" method="post" class="ticket-dialog-form">
                                            @Html.AntiForgeryToken()
                                            <div class="field">
                                                <label for="tecnico-@chamado.Id">Responsável de TI</label>
                                                <select id="tecnico-@chamado.Id" name="tecnicoTiId" class="input" required>
                                                    <option value="">Selecione</option>
                                                    @foreach (var tecnico in Model.TecnicosDisponiveis)
                                                    {
                                                        if (chamado.TecnicoTiId?.ToString() == tecnico.Value)
                                                        {
                                                            <option value="@tecnico.Value" selected>@tecnico.Text</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@tecnico.Value">@tecnico.Text</option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                            <div class="ticket-dialog-actions">
                                                <button type="button" class="btn ghost" data-dialog-close>Cancelar</button>
                                                <button type="submit" class="btn primary">Salvar responsável</button>
                                            </div>
                                        </form>
                                    </div>
                                </dialog>

                                @if (chamado.TecnicoTiId.HasValue)
                                {
                                    <dialog id="finalizar-dialog-@chamado.Id" class="ticket-dialog" aria-labelledby="finalizar-titulo-@chamado.Id">
                                        <div class="ticket-dialog-content">
                                            <div class="ticket-dialog-header">
                                                <div>
                                                    <span class="eyebrow">Chamado #@chamado.Id</span>
                                                    <h2 id="finalizar-titulo-@chamado.Id">Finalizar chamado</h2>
                                                </div>
                                                <button type="button" class="ticket-dialog-close" data-dialog-close aria-label="Fechar">×</button>
                                            </div>
                                            <form asp-action="FinalizarChamado" asp-route-id="@chamado.Id" method="post" class="ticket-dialog-form" data-finalize-ticket-form>
                                                @Html.AntiForgeryToken()
                                                <div class="field">
                                                    <label for="parecer-@chamado.Id">Parecer e o que foi feito (opcional)</label>
                                                    <textarea id="parecer-@chamado.Id" name="parecerFinal" class="input input-textarea" rows="2" maxlength="2000" placeholder="Descreva a solução aplicada, se desejar">@chamado.ParecerFinal</textarea>
                                                </div>
                                                <div class="ticket-dialog-actions">
                                                    <button type="button" class="btn ghost" data-dialog-close>Cancelar</button>
                                                    <button type="submit" class="btn primary">Confirmar finalização</button>
                                                </div>
                                            </form>
                                        </div>
                                    </dialog>
                                }
                            }
                        }
                    </article>
                }
            }
        </div>
    </div>

    <form asp-action="Limpar" method="post" class="clear-form">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn danger" onclick="return confirm('Deseja limpar todos os chamados?');">Limpar chamados</button>
    </form>
</section>
