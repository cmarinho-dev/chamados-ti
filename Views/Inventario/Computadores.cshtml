@model ChamadosTI.Models.InventarioComputadoresViewModel
@{
    ViewData["Title"] = "Computadores";

    string ExibirComQuantidade(
        IEnumerable<int> ids,
        IReadOnlyDictionary<int, string> descricoes,
        IReadOnlyDictionary<int, int> quantidades)
    {
        return string.Join(", ", ids.Select(id =>
        {
            var descricao = descricoes.TryGetValue(id, out var valorDescricao)
                ? valorDescricao
                : $"Item #{id}";
            var qtd = quantidades.TryGetValue(id, out var valor) ? valor : 1;
            return qtd > 1 ? $"{descricao} (x{qtd})" : descricao;
        }));
    }
}

<section class="page">
    <div class="page-header">
        <div>
            <p class="eyebrow">Inventário</p>
            <h1>Computadores e notebooks</h1>
        </div>
        <div class="header-actions">
            <a class="btn primary" asp-action="NovoComputador">Novo computador</a>
        </div>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert success">@success</div>
    }

    <div class="card dashboard">
        <form asp-action="Computadores" method="get" class="inventario-list-toolbar">
            <input class="input" type="search" name="busca" value="@Model.Paginacao.Busca" placeholder="Buscar por inventario, patrimonio, responsavel, setor ou IP" maxlength="120" />
            <input type="hidden" name="itensPorPagina" value="@Model.Paginacao.ItensPorPagina" />
            <button class="btn ghost" type="submit">Buscar</button>
            <a class="btn ghost" asp-action="Computadores" asp-route-itensPorPagina="@Model.Paginacao.ItensPorPagina">Limpar</a>
        </form>

        <div class="ticket-list">
            @if (Model.Itens.Count == 0)
            {
                <div class="muted">@(string.IsNullOrWhiteSpace(Model.Paginacao.Busca) ? "Nenhum computador cadastrado." : "Nenhum computador encontrado para a busca.")</div>
            }
            else
            {
                foreach (var item in Model.Itens)
                {
                    var memoriaDescricoes = item.MemoriasQuantidades
                        .Where(x => x.Memoria != null)
                        .GroupBy(x => x.MemoriaId)
                        .ToDictionary(x => x.Key, x => x.First().Memoria!.Descricao);
                    var armazenamentoDescricoes = item.ArmazenamentosQuantidades
                        .Where(x => x.Armazenamento != null)
                        .GroupBy(x => x.ArmazenamentoId)
                        .ToDictionary(x => x.Key, x => x.First().Armazenamento!.Descricao);

                    var memoriaQuantidades = item.MemoriasQuantidades
                        .GroupBy(x => x.MemoriaId)
                        .ToDictionary(x => x.Key, x => x.Max(y => y.Quantidade <= 0 ? 1 : y.Quantidade));
                    var armazenamentoQuantidades = item.ArmazenamentosQuantidades
                        .GroupBy(x => x.ArmazenamentoId)
                        .ToDictionary(x => x.Key, x => x.Max(y => y.Quantidade <= 0 ? 1 : y.Quantidade));

                    var memoriaIdsExibicao = memoriaQuantidades.Keys
                        .OrderBy(x => x)
                        .ToList();
                    var armazenamentoIdsExibicao = armazenamentoQuantidades.Keys
                        .OrderBy(x => x)
                        .ToList();
                    <article class="ticket">
                        <div class="ticket-header">
                            <div>
                                <strong>@item.InventarioNumero</strong>
                                <div class="muted">@(item.PessoaResponsavel ?? "Sem responsável") • @item.Setor?.Nome</div>
                            </div>
                            <div class="list-badges">
                                <span class="pill">@item.TipoEquipamento</span>
                                @if (item.EhBackup)
                                {
                                    <span class="pill subtle">Backup</span>
                                }
                            </div>
                        </div>

                        <div class="ticket-meta">
                            <div class="ticket-meta-main">
                                <span>RAM: @ExibirComQuantidade(memoriaIdsExibicao, memoriaDescricoes, memoriaQuantidades)</span>
                                <div class="ticket-meta-sep">|</div>
                                <span>Armazenamento: @ExibirComQuantidade(armazenamentoIdsExibicao, armazenamentoDescricoes, armazenamentoQuantidades)</span>
                            </div>
                            <span>@(string.IsNullOrWhiteSpace(item.Ip) ? "IP não informado" : item.Ip)</span>
                        </div>

                        <div class="ticket-meta">
                            <div class="ticket-meta-main">
                                <span>CPU: @string.Join(", ", item.Processadores.Select(c => c.Descricao))</span>
                                <div class="ticket-meta-sep">|</div>
                                <span>Monitores: @string.Join(", ", item.Monitores.Select(c => c.InventarioNumero))</span>
                            </div>
                            <span>@item.CriadoEm.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>

                        <div class="status-form">
                            <a class="btn ghost" asp-action="EditarComputador" asp-route-id="@item.Id">Editar</a>
                            <form asp-action="ExcluirComputador" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Deseja remover este computador?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn danger">Excluir</button>
                            </form>
                        </div>
                    </article>
                }
            }
        </div>

        @if (Model.Paginacao.TotalPaginas > 1)
        {
            <div class="header-actions inventario-pagination">
                <form asp-action="Computadores" method="get" class="componente-inline-form" style="margin: 0;">
                    <label class="muted" for="itensPorPaginaComputadores">Itens por página</label>
                    <select id="itensPorPaginaComputadores" name="itensPorPagina" class="input" style="min-width: 90px;" onchange="this.form.submit()">
                        @foreach (var i in new[] { 5, 10, 20, 50 })
                        {
                            <option value="@i" selected="@(Model.Paginacao.ItensPorPagina == i)">@(i)</option>
                        }
                    </select>
                    <input type="hidden" name="pagina" value="1" />
                    <input type="hidden" name="busca" value="@Model.Paginacao.Busca" />
                </form>
                @if (Model.Paginacao.PaginaAtual > 1)
                {
                    <a class="btn ghost" asp-action="Computadores" asp-route-pagina="@(Model.Paginacao.PaginaAtual - 1)" asp-route-itensPorPagina="@Model.Paginacao.ItensPorPagina" asp-route-busca="@Model.Paginacao.Busca" aria-label="Página anterior">←</a>
                }
                <span class="muted">Página @Model.Paginacao.PaginaAtual de @Model.Paginacao.TotalPaginas</span>
                @if (Model.Paginacao.PaginaAtual < Model.Paginacao.TotalPaginas)
                {
                    <a class="btn ghost" asp-action="Computadores" asp-route-pagina="@(Model.Paginacao.PaginaAtual + 1)" asp-route-itensPorPagina="@Model.Paginacao.ItensPorPagina" asp-route-busca="@Model.Paginacao.Busca" aria-label="Próxima página">→</a>
                }
            </div>
        }
    </div>
</section>
