@model ChamadosTI.Models.InventarioMonitoresViewModel
@{
    ViewData["Title"] = "Monitores";
}

<section class="page">
    <div class="page-header">
        <div>
            <p class="eyebrow">Inventário</p>
            <h1>Monitores</h1>
        </div>
        <div class="header-actions">
            <a class="btn primary" asp-action="NovoMonitor">Novo monitor</a>
        </div>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert success">@success</div>
    }

    <section class="card dashboard">
        <h2 class="section-title">Monitores cadastrados</h2>
        <form asp-action="Monitores" method="get" class="inventario-list-toolbar">
            <input class="input" type="search" name="busca" value="@Model.Paginacao.Busca" placeholder="Buscar por inventario, patrimonio, marca ou modelo" maxlength="120" />
            <input type="hidden" name="itensPorPagina" value="@Model.Paginacao.ItensPorPagina" />
            <button class="btn ghost" type="submit">Buscar</button>
            <a class="btn ghost" asp-action="Monitores" asp-route-itensPorPagina="@Model.Paginacao.ItensPorPagina">Limpar</a>
        </form>

        <div class="ticket-list">
            @if (Model.Monitores.Count == 0)
            {
                <div class="muted">@(string.IsNullOrWhiteSpace(Model.Paginacao.Busca) ? "Nenhum monitor cadastrado." : "Nenhum monitor encontrado para a busca.")</div>
            }
            else
            {
                foreach (var monitor in Model.Monitores)
                {
                    <article class="ticket">
                        <div class="ticket-header">
                            <div>
                                <strong>@monitor.InventarioNumero</strong>
                                <div class="muted">@((monitor.Marca ?? "Sem marca") + (string.IsNullOrWhiteSpace(monitor.Modelo) ? string.Empty : " • " + monitor.Modelo))</div>
                            </div>
                            <div class="list-badges">
                                <span class="pill">@(string.IsNullOrWhiteSpace(monitor.Polegadas) ? "Monitor" : monitor.Polegadas + "\"")</span>
                            </div>
                        </div>

                        <div class="ticket-meta">
                            <div class="ticket-meta-main">
                                <span>@(string.IsNullOrWhiteSpace(monitor.Patrimonio) ? "Patrimônio não informado" : "Patrimônio: " + monitor.Patrimonio)</span>
                                <div class="ticket-meta-sep">|</div>
                                <span>Vinculado em @monitor.InventarioItems.Count computador</span>
                            </div>
                            <span>@monitor.CriadoEm.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(monitor.Observacao))
                        {
                            <div class="ticket-meta">
                                <span>@monitor.Observacao</span>
                            </div>
                        }

                        <div class="status-form">
                            <a class="btn ghost" asp-action="EditarMonitor" asp-route-id="@monitor.Id">Editar</a>
                            <form asp-action="ExcluirMonitor" asp-route-id="@monitor.Id" method="post" onsubmit="return confirm('Deseja remover este monitor?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn danger">Excluir</button>
                            </form>
                        </div>
                    </article>
                }
            }
        </div>

        @if (Model.Paginacao.TotalPaginas > 1)
        {
            <div class="header-actions inventario-pagination">
                <form asp-action="Monitores" method="get" class="componente-inline-form" style="margin: 0;">
                    <label class="muted" for="itensPorPaginaMonitores">Itens por página</label>
                    <select id="itensPorPaginaMonitores" name="itensPorPagina" class="input" style="min-width: 90px;" onchange="this.form.submit()">
                        @foreach (var i in new[] { 5, 10, 20, 50 })
                        {
                            <option value="@i" selected="@(Model.Paginacao.ItensPorPagina == i)">@(i)</option>
                        }
                    </select>
                    <input type="hidden" name="pagina" value="1" />
                    <input type="hidden" name="busca" value="@Model.Paginacao.Busca" />
                </form>
                @if (Model.Paginacao.PaginaAtual > 1)
                {
                    <a class="btn ghost" asp-action="Monitores" asp-route-pagina="@(Model.Paginacao.PaginaAtual - 1)" asp-route-itensPorPagina="@Model.Paginacao.ItensPorPagina" asp-route-busca="@Model.Paginacao.Busca" aria-label="Página anterior">←</a>
                }
                <span class="muted">Página @Model.Paginacao.PaginaAtual de @Model.Paginacao.TotalPaginas</span>
                @if (Model.Paginacao.PaginaAtual < Model.Paginacao.TotalPaginas)
                {
                    <a class="btn ghost" asp-action="Monitores" asp-route-pagina="@(Model.Paginacao.PaginaAtual + 1)" asp-route-itensPorPagina="@Model.Paginacao.ItensPorPagina" asp-route-busca="@Model.Paginacao.Busca" aria-label="Próxima página">→</a>
                }
            </div>
        }
    </section>
</section>
