@model ChamadosTI.Models.InventarioFormViewModel
@{
    ViewData["Title"] = "Editar computador";
}

<section class="page">
    <div class="page-header">
        <div>
            <p class="eyebrow">Inventário</p>
            <h1>Editar computador</h1>
        </div>
    </div>

    <form asp-action="EditarComputador" asp-route-id="@Model.Id" method="post" class="card form-grid" data-inventario-form>
        @Html.AntiForgeryToken()
        <partial name="_ComputadorForm" model="Model" />
        <div class="form-actions">
            <button type="submit" class="btn primary">Salvar alterações</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
