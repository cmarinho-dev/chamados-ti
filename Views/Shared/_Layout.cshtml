@{
    var path = Context.Request.Path.Value ?? string.Empty;
    var isNotAdmin = string.Equals(path, "/", StringComparison.OrdinalIgnoreCase)
        || string.Equals(path, "/home/index", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Chamados TI</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="alternate icon" href="/favicon.ico" type="image/x-icon" sizes="any">

</head>
<body class="@(isNotAdmin ? string.Empty : "has-admin-nav")">
    @if (isNotAdmin)
    {
        <header>
            <div class="nav">
                <a class="brand" asp-controller="Home" asp-action="Index">Chamados TI</a>
                <a href="https://imap.curitiba.pr.gov.br">
                    <img src="~/images/imap.png" width="205" alt="Site do IMAP" />
                </a>
            </div>
        </header>
    }
    else
    {
        <nav class="admin-nav" data-admin-nav>
            <div class="admin-nav-inner">
                <div class="admin-nav-brand">
                    <a href="https://imap.curitiba.pr.gov.br">
                        <img src="~/images/imap.png" width="195" alt="Site do IMAP" />
                    </a>
                </div>

                <button class="admin-nav-toggle" type="button" data-admin-nav-toggle aria-controls="admin-nav-menu" aria-expanded="false">
                    <span class="sr-only">Abrir menu</span>
                    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M5 7h14M5 12h14M5 17h14" />
                    </svg>
                </button>

                <div class="admin-nav-menu" id="admin-nav-menu" data-admin-nav-menu>
                    <ul class="admin-nav-list">
                        <li>
                            <a asp-controller="Admin" asp-action="Index">Chamados</a>
                        </li>
                        @* <li>
                            <a asp-controller="Admin" asp-action="SqlExecutor">SQL</a>
                        </li> *@
                        <li class="admin-nav-dropdown">
                            <button type="button" data-admin-dropdown-toggle aria-expanded="false">
                                Administrativo
                                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9-7 7-7-7" />
                                </svg>
                            </button>
                            <div class="admin-nav-dropdown-menu" data-admin-dropdown-menu>
                                <a asp-controller="Administrativo" asp-action="Departamentos">Departamentos</a>
                                <a asp-controller="Administrativo" asp-action="EquipeTi">Equipe de TI</a>
                            </div>
                        </li>
                        <li class="admin-nav-dropdown">
                            <button type="button" data-admin-dropdown-toggle aria-expanded="false">
                                Inventário
                                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9-7 7-7-7" />
                                </svg>
                            </button>
                            <div class="admin-nav-dropdown-menu" data-admin-dropdown-menu>
                                <a asp-controller="Inventario" asp-action="Computadores">Computadores</a>
                                <a asp-controller="Inventario" asp-action="Componentes">Componentes</a>
                                <a asp-controller="Inventario" asp-action="Monitores">Monitores</a>
                                <a asp-controller="Inventario" asp-action="Chaves">Chaves</a>
                                <a asp-controller="Inventario" asp-action="OutrosDispositivos">Outros dispositivos</a>
                                <a asp-controller="Inventario" asp-action="Relatorios">Relatórios</a>
                            </div>
                        </li>
                        <li>
                            <a asp-controller="Home" asp-action="Index">Início</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    }

    <main role="main" class="page-shell">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="footer-inner">
            <span>© 2026 NIT IMAP</span>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
